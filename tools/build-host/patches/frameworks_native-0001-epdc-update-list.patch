+// BOOXOS: The Onyx e-ink controller only refreshes the panel for regions that
+// SurfaceFlinger lists with each present (stock: EpdcManager). Send one
+// full-screen item per frame. Mode word: debug.booxos.epdc_mode (live tuning),
+// else ro.surface_flinger.booxos_epdc_mode; negative disables. Every Nth update
+// (ro.surface_flinger.booxos_epdc_full_every, 0 = never) uses
+// ro.surface_flinger.booxos_epdc_full_mode to clear ghosting.
+void HidlComposer::writeBooxosEpdc() {
+    static const int32_t kDefaultMode =
+            base::GetIntProperty("ro.surface_flinger.booxos_epdc_mode", -1);
+    static const int32_t kFullMode =
+            base::GetIntProperty("ro.surface_flinger.booxos_epdc_full_mode", -1);
+    static const int32_t kFullEvery =
+            base::GetIntProperty("ro.surface_flinger.booxos_epdc_full_every", 0);
+    static uint32_t sCount = 0;
+    int32_t mode = base::GetIntProperty("debug.booxos.epdc_mode", kDefaultMode);
+    if (mode < 0) return;
+    if (kFullEvery > 0 && kFullMode >= 0 && (++sCount % static_cast<uint32_t>(kFullEvery)) == 0) {
+        mode = kFullMode;
+    }
+    mWriter.setDisplayEpdc({0, 0, 32767, 32767, mode});
+}
+
 Error HidlComposer::presentDisplay(Display display, int* outPresentFence) {
     ATRACE_NAME("HwcPresentDisplay");
     mWriter.selectDisplay(display);
+    writeBooxosEpdc();
     mWriter.presentDisplay();
 
     Error error = execute();
