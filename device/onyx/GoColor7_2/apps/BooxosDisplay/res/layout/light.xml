<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="24dp" android:minWidth="480dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/brightness" android:textSize="18sp" android:textColor="#000000" />
    <SeekBar android:id="@+id/brightness" android:layout_width="match_parent"
        android:layout_height="56dp" android:max="255" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/warmth" android:textSize="18sp" android:textColor="#000000" />
    <SeekBar android:id="@+id/warmth" android:layout_width="match_parent"
        android:layout_height="56dp" android:max="32" />
    <Button android:id="@+id/done" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="end"
        android:layout_marginTop="16dp" android:text="@string/done" />
</LinearLayout>
