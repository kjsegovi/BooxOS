<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.booxos.display"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.MODIFY_DAY_NIGHT_MODE" />
    <uses-permission android:name="lineageos.permission.WRITE_SECURE_SETTINGS" />

    <application android:label="@string/app_name" android:allowBackup="false">

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <activity android:name=".LightActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:label="@string/light"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog.NoActionBar" />

        <service android:name=".LightTileService"
            android:exported="true"
            android:icon="@drawable/ic_light"
            android:label="@string/light"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service android:name=".ColorTileService"
            android:exported="true"
            android:icon="@drawable/ic_mono"
            android:label="@string/mono"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
