# BOOXOS_BRINGUP only (debug builds). Never ship.
# Diagnostic probe: stage breadcrumbs on /metadata, front-light stage code,
# early USB adb, self-reboot on stall. See booxos-probe.sh.
service booxos_probe /system/bin/sh /product/etc/booxos-probe.sh
    user root
    group root shell system log
    seclabel u:r:su:s0
    oneshot
    disabled

on init
    start booxos_probe
