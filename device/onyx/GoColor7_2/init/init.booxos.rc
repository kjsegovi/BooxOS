# BOOXOS: device init for all builds (installed to /product/etc/init).

# Touch controller (istaric IS5662 on i2c 2-0055). After boot the Onyx driver
# leaves the touch IRQ disabled ("onyx_tp_irq_set ... Off" at the end of probe;
# IRQ count stays at 1), so the kernel never reports touches. A controller reset
# through the driver's own sysfs node turns the IRQ back on (tested 2026-11-18).
# The node is labeled booxos_sysfs_touch (sepolicy/private) so init may write it.
on property:sys.boot_completed=1
    write /sys/devices/platform/soc/988000.i2c/i2c-2/2-0055/reset 1

# Front-light warmth (0-32), set by the BooxOS Display app's Light tile and kept
# across reboots as a persistent property.
on property:persist.booxos.light.warmth=*
    write /sys/class/backlight/onyx_bl_ct/brightness ${persist.booxos.light.warmth}
